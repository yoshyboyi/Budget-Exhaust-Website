# Public site URL (used for canonical URLs, sitemap, schema)
NEXT_PUBLIC_SITE_URL=https://www.budgetexhaust.net.au

# Form submission endpoint (e.g. Formspree, Resend, or a custom API route)
QUOTE_FORM_ENDPOINT=

# Email address form submissions get forwarded to
QUOTE_FORM_TO_EMAIL=info@budgetexhaust.net.au

# Google Maps embed API key (optional - falls back to a static map link without it)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics (e.g. GA4 measurement ID or Plausible domain) - leave blank until confirmed with owner
NEXT_PUBLIC_ANALYTICS_ID=
